# Required — Claude powers resume parsing, job scoring, and all drafting
ANTHROPIC_API_KEY=

# Gmail API (send approved emails). Create OAuth client at console.cloud.google.com
# → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3040/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — hiring-manager email lookup (either works; Apollo preferred)
APOLLO_API_KEY=
HUNTER_API_KEY=

# Optional — freelance biz-dev lead search (Places API New)
GOOGLE_PLACES_API_KEY=

# Safety cap: max emails sent per day
DAILY_EMAIL_CAP=40
