# Required — Claude powers resume parsing, job scoring, and all drafting
ANTHROPIC_API_KEY=

# Gmail API (send approved emails). Create OAuth client at console.cloud.google.com
# → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3040/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — hiring-manager email lookup (either works; Apollo preferred)
APOLLO_API_KEY=
HUNTER_API_KEY=

# Optional — freelance biz-dev lead search (Places API New)
GOOGLE_PLACES_API_KEY=

# Safety cap: max emails sent per day
DAILY_EMAIL_CAP=40

# Model overrides (optional). Defaults: cheap Haiku for job scoring,
# Opus for resume parsing + all outbound drafts.
# SCORE_MODEL=claude-haiku-4-5
# DRAFT_MODEL=claude-opus-4-8   # or claude-sonnet-5 for ~60% cheaper drafts

# Country code used for WhatsApp links when a lead region omits the country
DEFAULT_COUNTRY_CODE=91

# Opt in to LinkedIn public job search (no login; breaches their ToS & rate-limits by IP)
ENABLE_LINKEDIN=false

# Firecrawl (open-web job discovery). Query budget is per hunt; each call is
# paced to stay under the plan's requests-per-minute cap.
FIRECRAWL_API_KEY=
# FIRECRAWL_MIN_GAP_MS=5200     # 12 req/min plan -> 5s between calls
# FIRECRAWL_OPEN_QUERIES=6      # untargeted "<role> jobs hiring <place>" searches
# FIRECRAWL_BIGTECH_QUERIES=2   # Apple / Meta / Microsoft / Netflix / Google careers
# FIRECRAWL_ATS_QUERIES=2       # Greenhouse/Lever/Ashby (already covered by their APIs)
# MAX_EXTRACT_PAGES=30          # pages read by the model per hunt
# EXTRACT_CONCURRENCY=6
